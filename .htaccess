# SafarSathi Root Apache Configuration
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Block access to sensitive files
<FilesMatch "^(\.env|\.sqlite|composer\.|package\.|schema\.sql)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /api/* directly to api/index.php
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # Route /backend/* directly to backend/index.php
    RewriteRule ^backend(/.*)?$ backend/index.php [QSA,L]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If file exists inside frontend/dist (e.g. assets/*), serve it
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # Fallback for React Single Page Application (Client Router)
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # All other routes pass to index.php (which loads frontend/dist/index.html)
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

