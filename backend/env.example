# SafarSathi Environment Configuration
# Copy this file to .env and configure your credentials

# Application Environment (development or production)
APP_ENV=development

# Database Configuration (Hostinger / MySQL / MariaDB)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safarsathi_db
